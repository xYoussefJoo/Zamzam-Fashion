root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.cs]
indent_size = 4

[*.{csproj,slnx,props,targets}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Windows PowerShell 5.1 reads UTF-8 without a BOM as ANSI, which garbles the Arabic in our scripts.
[*.ps1]
charset = utf-8-bom
